DATABASE_POOL_MAX=10
DATABASE_SSL=false

JWT_ACCESS_SECRET=0000000000000000000000000000000000000000
JWT_REFRESH_SECRET=1111111111111111111111111111111111111111
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_ISSUER=cadeau-crm

