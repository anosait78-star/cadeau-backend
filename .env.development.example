# Development — copy to .env.development. Values are non-secret local dummies.
# Generate your own before touching real data:  openssl rand -hex 32
NODE_ENV=development
APP_PORT=3000
APP_URL=http://localhost:3000
LOG_LEVEL=debug
REQUEST_TIMEOUT_MS=30000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_CREDENTIALS=true

