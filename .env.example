# =============================================================================
# Cadeau CRM — canonical environment template (reference).
# Copy the environment-specific template you need:
#   .env.development.example  -> .env.development
#   .env.test.example         -> .env.test
#   .env.staging.example      -> .env.staging   (secrets via secrets manager)
#   .env.production.example   -> .env.production (secrets via secrets manager)
#
# NEVER commit real secrets. Full reference: docs/configuration.md
# Generate secrets:  openssl rand -hex 32
# =============================================================================

# --- App / HTTP ---
NODE_ENV=development                 # development | test | staging | production (required)
APP_PORT=3000                        # 1-65535 (default 3000)
APP_URL=http://localhost:3000        # required; must be https in production
LOG_LEVEL=info                       # fatal|error|warn|info|debug|trace (default info)
REQUEST_TIMEOUT_MS=30000             # 1000-120000 (default 30000)
CORS_ALLOWED_ORIGINS=http://localhost:5173   # comma-separated; no '*' in production (required)
CORS_CREDENTIALS=false               # true|false (default false)

# --- Database (secret) ---
DATABASE_URL=postgresql://user:pass@localhost:5432/cadeau   # required
DATABASE_POOL_MAX=10                 # 1-100 (default 10)
DATABASE_SSL=false                   # true|false; must be true in production

# --- JWT (secret) ---
JWT_ACCESS_SECRET=                   # required, >= 32 chars
JWT_REFRESH_SECRET=                  # required, >= 32 chars, must differ from access
JWT_ACCESS_TTL=15m                   # duration (e.g. 15m, 3600s)
JWT_REFRESH_TTL=7d                   # duration (e.g. 7d)
JWT_ISSUER=cadeau-crm                # default cadeau-crm

# --- Encryption (secret) ---
ENCRYPTION_KEY=                      # required, 64 hex chars (32 bytes) — openssl rand -hex 32
PII_HASH_KEY=                        # required, 64 hex chars — blind-index HMAC key; MUST differ from ENCRYPTION_KEY

# --- Shipping webhooks (secret) ---
SHIPPING_WEBHOOK_SIGNING_SECRET=      # required, 64 hex chars — HMAC key verifying inbound carrier webhooks; MUST differ from ENCRYPTION_KEY/PII_HASH_KEY

# --- OAuth (secret, optional) ---
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=

# --- Third-party APIs (secret, optional) ---
# WHATSAPP_API_KEY=
# SHIPPING_BOSTA_API_KEY=
