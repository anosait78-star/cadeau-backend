# Staging — copy to .env.staging. Real secrets are INJECTED via the secrets
# manager / platform env, NOT committed. Placeholders below must be replaced.
NODE_ENV=staging
APP_PORT=3000
APP_URL=https://staging.cadeau.example
LOG_LEVEL=info
REQUEST_TIMEOUT_MS=30000
CORS_ALLOWED_ORIGINS=https://staging.cadeau.example
CORS_CREDENTIALS=true

DATABASE_URL=__INJECTED_VIA_SECRETS_MANAGER__
DATABASE_POOL_MAX=20
DATABASE_SSL=true

JWT_ACCESS_SECRET=__INJECTED_VIA_SECRETS_MANAGER__
JWT_REFRESH_SECRET=__INJECTED_VIA_SECRETS_MANAGER__
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_ISSUER=cadeau-crm

ENCRYPTION_KEY=__INJECTED_VIA_SECRETS_MANAGER__
