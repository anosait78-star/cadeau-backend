{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // NestJS uses decorators + DI reflection, so we compile to CommonJS with
    // classic node resolution and emit decorator metadata (needed for DI).
    "module": "CommonJS",
    "moduleResolution": "Node",
    "target": "ES2022",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    // Keep decorator-based class metadata intact for class-validator / Nest DI.
    "useDefineForClassFields": false,
    "outDir": "./dist",
    "rootDir": "./src",
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
