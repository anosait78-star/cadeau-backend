# Production — copy to .env.production. All secrets are INJECTED via the secrets
# manager / platform env, NEVER committed. The app refuses to boot in production
# if any secret still holds a placeholder value (production hardening).
NODE_ENV=production
APP_PORT=3000
APP_URL=https://app.cadeau.example
LOG_LEVEL=info
REQUEST_TIMEOUT_MS=30000
CORS_ALLOWED_ORIGINS=https://app.cadeau.example
CORS_CREDENTIALS=true

DATABASE_URL=__INJECTED_VIA_SECRETS_MANAGER__
DATABASE_POOL_MAX=40
DATABASE_SSL=true

JWT_ACCESS_SECRET=__INJECTED_VIA_SECRETS_MANAGER__
JWT_REFRESH_SECRET=__INJECTED_VIA_SECRETS_MANAGER__
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_ISSUER=cadeau-crm

ENCRYPTION_KEY=__INJECTED_VIA_SECRETS_MANAGER__
