{
  "name": "@cadeau/database",
  "version": "0.0.0",
  "private": true,
  "description": "Database infrastructure: Prisma client, migrations, RLS tenant context, transactions, health, and an (empty) idempotent seed framework.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "prisma"
  ],
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "type-check": "prisma generate && tsc -p tsconfig.json --noEmit",
    "test": "prisma generate && vitest run --coverage",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:seed": "prisma db seed",
    "db:seed:dev": "tsx prisma/seed-dev.ts",
    "db:reset": "prisma migrate reset"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@cadeau/config": "workspace:*",
    "@prisma/client": "6.19.3"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.10",
    "prisma": "6.19.3",
    "tsx": "4.23.1",
    "vitest": "4.1.10"
  }
}
